# ============================================================
# ND PERFUME — SERVER ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in your values.
# NEVER commit your real `.env`.
# ============================================================

# --- MongoDB ---
# Create a free cluster at https://www.mongodb.com/atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Or use a local MongoDB instance, e.g. mongodb://127.0.0.1:27017/ndperfume
MONGODB_URI=mongodb://127.0.0.1:27017/ndperfume

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Frontend origin (CORS) ---
CLIENT_ORIGIN=http://localhost:5173

# --- Admin (first admin seeded from these credentials) ---
ADMIN_EMAIL=admin@ndperfume.in
ADMIN_PASSWORD=Admin@123

# --- Future integrations (optional placeholders) ---
DELHIVERY_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
